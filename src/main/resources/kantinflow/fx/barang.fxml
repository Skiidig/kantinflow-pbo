<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="halaman" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kantinflow.fx.BarangController"
      styleClass="page" spacing="16">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <VBox styleClass="page-header" spacing="4">
        <Label text="Barang" styleClass="page-title"/>
        <Label text="Kelola barang dan batas stok minimum."
               styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="card" spacing="10">
        <Label text="Daftar Barang" styleClass="card-title"/>
        <TableView fx:id="tabelBarang" id="tabelBarang" prefHeight="190">
            <columns>
                <TableColumn fx:id="kolomNama" text="Nama" prefWidth="280"/>
                <TableColumn fx:id="kolomSatuan" text="Satuan" prefWidth="160"/>
                <TableColumn fx:id="kolomMinimum" text="Stok Minimum"
                             prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>

    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox styleClass="card" spacing="8" GridPane.columnIndex="0"
              GridPane.rowIndex="0">
            <Label text="Tambah Barang" styleClass="card-title"/>
            <Label text="Nama barang *" styleClass="field-label"/>
            <TextField fx:id="namaBaruField" id="namaBarangBaru"
                       promptText="contoh: Roti"/>
            <Label text="Satuan *" styleClass="field-label"/>
            <TextField fx:id="satuanBaruField" id="satuanBarangBaru"
                       promptText="contoh: bungkus"/>
            <Label text="Stok minimum * (bilangan bulat >= 0)"
                   styleClass="field-label"/>
            <TextField fx:id="minimumBaruField" id="minimumBarangBaru"
                       text="0"/>
            <Label fx:id="errorTambahLabel" id="errorTambahBarang"
                   styleClass="error-text" wrapText="true"/>
            <Button fx:id="tambahButton" id="tombolTambahBarang"
                    text="Tambah Barang" styleClass="primary-button"
                    maxWidth="Infinity"/>
        </VBox>

        <VBox styleClass="card" spacing="8" GridPane.columnIndex="1"
              GridPane.rowIndex="0">
            <Label text="Minimum Barang Aktif" styleClass="card-title"/>
            <Label fx:id="barangAktifLabel" id="barangAktifLabel"
                   styleClass="accent-text" wrapText="true"/>
            <Label text="Stok minimum * (bilangan bulat >= 0)"
                   styleClass="field-label"/>
            <TextField fx:id="minimumAktifField" id="minimumBarangAktif"/>
            <Label fx:id="errorMinimumLabel" id="errorMinimumBarang"
                   styleClass="error-text" wrapText="true"/>
            <Button fx:id="simpanMinimumButton" id="tombolSimpanMinimum"
                    text="Simpan Minimum" styleClass="primary-button"
                    maxWidth="Infinity"/>
            <Label text="Nilai minimum dipakai Ringkasan untuk menentukan status restok."
                   styleClass="note" wrapText="true"/>
        </VBox>
    </GridPane>
</VBox>
