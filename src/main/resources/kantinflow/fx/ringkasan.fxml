<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="halaman" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kantinflow.fx.RingkasanController"
      styleClass="page" spacing="16">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <VBox styleClass="page-header" spacing="4">
        <Label text="Ringkasan" styleClass="page-title"/>
        <Label text="Kondisi stok barang aktif dan kebutuhan restok."
               styleClass="page-subtitle"/>
    </VBox>

    <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Barang aktif" styleClass="field-label"/>
            <Label fx:id="barangAktifLabel" id="ringkasanBarang"
                   styleClass="context-value" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Tanggal pengecekan" styleClass="field-label"/>
        <DatePicker fx:id="tanggalPicker" id="tanggalRingkasan" prefWidth="150"/>
        <Button fx:id="periksaButton" id="periksaRingkasan" text="Periksa"
                styleClass="primary-button"/>
    </HBox>

    <Label fx:id="errorLabel" id="errorRingkasan" styleClass="error-text"
           wrapText="true"/>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <VBox styleClass="stat-card" GridPane.columnIndex="0"
              GridPane.rowIndex="0" spacing="6">
            <Label text="Stok fisik" styleClass="stat-title"/>
            <Label fx:id="fisikLabel" id="ringkasanFisik" text="-" styleClass="stat-value"/>
            <Label text="Seluruh sisa batch" styleClass="stat-note"/>
        </VBox>
        <VBox styleClass="stat-card" GridPane.columnIndex="1"
              GridPane.rowIndex="0" spacing="6">
            <Label text="Stok layak" styleClass="stat-title"/>
            <Label fx:id="layakLabel" id="ringkasanLayak" text="-" styleClass="stat-value"/>
            <Label text="Batch yang layak pada tanggal pengecekan"
                   styleClass="stat-note" wrapText="true"/>
        </VBox>
        <VBox styleClass="stat-card" GridPane.columnIndex="0"
              GridPane.rowIndex="1" spacing="6">
            <Label text="Stok minimum" styleClass="stat-title"/>
            <Label fx:id="minimumLabel" id="ringkasanMinimum" text="-" styleClass="stat-value"/>
            <Label text="Batas kebutuhan barang aktif" styleClass="stat-note"/>
        </VBox>
        <VBox styleClass="stat-card" GridPane.columnIndex="1"
              GridPane.rowIndex="1" spacing="6">
            <Label text="Status restok" styleClass="stat-title"/>
            <Label fx:id="statusRestokLabel" id="ringkasanStatus" text="Belum diperiksa"
                   styleClass="stat-value"/>
            <Label text="Perlu restok jika stok layak kurang dari atau sama dengan minimum"
                   styleClass="stat-note" wrapText="true"/>
        </VBox>
    </GridPane>

    <VBox styleClass="card" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Batch Barang Aktif" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Berdasarkan tanggal pengecekan" styleClass="note"/>
        </HBox>
        <TableView fx:id="tabelBatch" id="tabelBatchRingkasan"
                   prefHeight="210">
            <columns>
                <TableColumn fx:id="kolomKode" text="Kode Batch" prefWidth="150"/>
                <TableColumn fx:id="kolomSisa" text="Sisa" prefWidth="95"/>
                <TableColumn fx:id="kolomMasuk" text="Tanggal Masuk" prefWidth="125"/>
                <TableColumn fx:id="kolomKedaluwarsa" text="Kedaluwarsa" prefWidth="125"/>
                <TableColumn fx:id="kolomStatus" text="Status" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

    <Label text="Stok layak memakai aturan FEFO: batch bersisa dan belum kedaluwarsa."
           styleClass="note" wrapText="true"/>
</VBox>
