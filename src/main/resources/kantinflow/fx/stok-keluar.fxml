<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="halaman" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kantinflow.fx.StokKeluarController"
      styleClass="page" spacing="16">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <VBox styleClass="page-header" spacing="4">
        <Label text="Stok Keluar" styleClass="page-title"/>
        <Label text="Keluarkan stok manual dari batch atau gunakan FEFO."
               styleClass="page-subtitle"/>
    </VBox>

    <TabPane fx:id="modeTabs" styleClass="mode-tabs"
             tabClosingPolicy="UNAVAILABLE">
        <Tab text="Manual">
            <VBox styleClass="tab-panel" spacing="12" maxWidth="620">
                <Label text="Keluarkan stok dari satu batch yang dipilih."
                       styleClass="note" wrapText="true"/>
                <Label text="Batch *" styleClass="field-label"/>
                <ComboBox fx:id="batchCombo" id="batchManual" maxWidth="Infinity"/>
                <Label fx:id="sisaBatchLabel" id="sisaBatch"
                       styleClass="accent-text" wrapText="true"/>
                <Label text="Jumlah *" styleClass="field-label"/>
                <TextField fx:id="jumlahManualField" id="jumlahKeluar"
                           promptText="bilangan bulat"/>
                <Button fx:id="manualButton" id="tombolKeluarkan"
                        text="Keluarkan Manual" styleClass="primary-button"
                        maxWidth="Infinity"/>
            </VBox>
        </Tab>

        <Tab text="FEFO">
            <VBox styleClass="tab-panel" spacing="12" maxWidth="620">
                <Label text="Batch layak dengan kedaluwarsa terdekat digunakan lebih dahulu."
                       styleClass="note" wrapText="true"/>
                <Label text="Jumlah *" styleClass="field-label"/>
                <TextField fx:id="jumlahFefoField" id="jumlahFefo"
                           promptText="bilangan bulat"/>
                <Label text="Tanggal pengeluaran *" styleClass="field-label"/>
                <DatePicker fx:id="tanggalFefoPicker" id="tanggalFefo"
                            maxWidth="Infinity"/>
                <Button fx:id="fefoButton" id="tombolFefo" text="Keluarkan FEFO"
                        styleClass="primary-button" maxWidth="Infinity"/>
            </VBox>
        </Tab>
    </TabPane>

    <Label fx:id="errorLabel" id="errorStokKeluar" styleClass="error-text"
           wrapText="true"/>

    <VBox styleClass="result-card" spacing="8">
        <Label text="Hasil Alokasi" styleClass="card-title"/>
        <Label fx:id="hasilAlokasiLabel" id="hasilAlokasi"
               styleClass="allocation" wrapText="true"/>
    </VBox>

    <Label text="Tanggal pengeluaran tidak boleh sebelum tanggal masuk batch."
           styleClass="note" wrapText="true"/>
</VBox>
