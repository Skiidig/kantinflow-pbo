<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kantinflow.fx.ShellController"
            styleClass="root">
    <left>
        <VBox styleClass="sidebar" prefWidth="232" spacing="9">
            <padding>
                <javafx.geometry.Insets top="22" right="16" bottom="16" left="16"/>
            </padding>
            <Label text="KantinFlow" styleClass="brand"/>
            <Label text="Manajemen Persediaan" styleClass="brand-sub"/>
            <Label text="Barang aktif" styleClass="field-label">
                <VBox.margin>
                    <javafx.geometry.Insets top="14" bottom="0" right="0" left="0"/>
                </VBox.margin>
            </Label>
            <ComboBox fx:id="barangCombo" id="barangAktif" maxWidth="Infinity"/>
            <VBox styleClass="nav-box" spacing="3">
                <Label text="Menu" styleClass="nav-section-label"/>
                <ToggleButton fx:id="navRingkasan" id="navRingkasan" text="▦  Ringkasan"
                              styleClass="nav-button" maxWidth="Infinity"
                              onAction="#tampilkanRingkasan"/>
                <ToggleButton fx:id="navBarang" id="navBarang" text="▤  Barang"
                              styleClass="nav-button" maxWidth="Infinity"
                              onAction="#tampilkanBarang"/>
                <ToggleButton fx:id="navStokMasuk" id="navStokMasuk" text="↓  Stok Masuk"
                              styleClass="nav-button" maxWidth="Infinity"
                              onAction="#tampilkanStokMasuk"/>
                <ToggleButton fx:id="navStokKeluar" id="navStokKeluar" text="↑  Stok Keluar"
                              styleClass="nav-button" maxWidth="Infinity"
                              onAction="#tampilkanStokKeluar"/>
            </VBox>
            <VBox styleClass="nav-soon-box" spacing="3">
                <Label text="Segera tersedia" styleClass="nav-section-label"/>
                <ToggleButton text="◷  Pemantauan" styleClass="nav-button"
                              maxWidth="Infinity" disable="true"/>
                <ToggleButton text="↧  Pembuangan" styleClass="nav-button"
                              maxWidth="Infinity" disable="true"/>
                <ToggleButton text="≡  Riwayat" styleClass="nav-button"
                              maxWidth="Infinity" disable="true"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="JavaFX 25 · SQLite" styleClass="sidebar-footer"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="halamanContainer" styleClass="content"/>
    </center>
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="statusLabel" id="status" text="Memuat data..."
                   styleClass="status" HBox.hgrow="ALWAYS" wrapText="true"/>
            <ProgressIndicator fx:id="progress" prefWidth="20" prefHeight="20"
                               visible="false" managed="false"/>
        </HBox>
    </bottom>
</BorderPane>
